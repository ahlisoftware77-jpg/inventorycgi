
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user role
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    // Helper to get user department
    function getUserDept(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.department;
    }

    // Helper functions to check specific permissions
    function canManageInventory(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.permissions.canManageInventory == true;
    }

    function canDeleteInventory(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.permissions.canDeleteInventory == true;
    }

    // Rules for the 'assets' collection
    match /assets/{assetId} {
      // Allow public get and list for verification and public catalogs
      allow get, list: if true;
      allow create, update: if request.auth != null && getUserRole(request.auth.uid) in ['Admin', 'Manager', 'Section Head', 'Karyawan'];
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserRole(request.auth.uid) == 'Admin');
      allow update: if request.auth != null && (request.auth.uid == userId || getUserRole(request.auth.uid) == 'Admin');
      allow create: if request.auth != null;
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
      
      match /todos/{todoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /it_problem_reports/{reportId} {
      // Allow public to get and list reports for status tracking
      allow get, list: if true;
      allow create: if true;
      allow update: if true; // Diperlukan agar user publik bisa mengisi tanda tangan di laporan yang sudah ada
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }

    // Rules for public shared content
    match /public_shares/{shareId} {
      allow read: if true; 
      allow create: if request.auth != null;
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }
    
    // Rules for public shared reports
    match /public_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }
    
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && (getUserRole(request.auth.uid) == 'Admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department in ['HR', 'GA', 'HR & GA']);
    }

    match /it_assets/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserRole(request.auth.uid) in ['Admin', 'Manager', 'Section Head'];
    }

    match /inventory/{id} {
      // Allow public read for inventory catalog
      allow read: if true;
      allow create, update: if request.auth != null && (
        getUserRole(request.auth.uid) == 'Admin' || 
        getUserDept(request.auth.uid) == 'HR & GA' ||
        canManageInventory(request.auth.uid)
      );
      allow delete: if request.auth != null && (
        getUserRole(request.auth.uid) == 'Admin' ||
        canDeleteInventory(request.auth.uid)
      );
    }

    match /inventory_requests/{id} {
      allow read: if request.auth != null;
      // Allow public GET (single document read) for the public signature page
      allow get: if true;
      // Allow public create for inventory requests (Ambil Barang Tanpa Login)
      allow create: if true;
      // Allow authenticated Admin/HRGA full update & delete
      allow update, delete: if request.auth != null && (
        getUserRole(request.auth.uid) == 'Admin' || 
        getUserDept(request.auth.uid) == 'HR & GA' ||
        canManageInventory(request.auth.uid)
      );
      // Allow unauthenticated update ONLY for department verifier signature fields
      allow update: if request.auth == null &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['verifierDeptSignature', 'verifierDeptName', 'verifierDeptSignedAt']);
    }

    match /recycle_bin/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /inventory_transactions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }

    match /helpdesk_tickets/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true;
    }
    
    match /maintenance_schedules/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null && (getUserRole(request.auth.uid) == 'Admin' || resource.data.department == getUserDept(request.auth.uid));
    }

    match /system_logs/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }

    match /audits/{period}/assets/{assetId} {
      allow read: if true;
      allow write: if true;
    }

    match /audits/{period}/signatures/{deptId} {
      allow read, write: if true;
    }
    
    match /settings/{id} {
      allow read: if id != 'email' || (request.auth != null && getUserRole(request.auth.uid) == 'Admin');
      allow write: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }

    match /data_fix_asset_accounting/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserRole(request.auth.uid) == 'Admin';
    }
  }
}
